</section>

<!-- COUNTDOWN -->
<section class="countdown-section">
    <div class="container text-center">
        <p class="font-mono text-muted-cb mb-3" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.15em;">
            <i class="fa-solid fa-clock me-1 text-orange"></i> T-Minus to Launch
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <div class="countdown-unit">
                <span class="countdown-number">@_days.ToString("D2")</span>
                <span class="countdown-label">Days</span>
            </div>
            <div class="countdown-unit">
                <span class="countdown-number">@_hours.ToString("D2")</span>
                <span class="countdown-label">Hours</span>
            </div>
            <div class="countdown-unit">
                <span class="countdown-number">@_minutes.ToString("D2")</span>
                <span class="countdown-label">Minutes</span>
            </div>
            <div class="countdown-unit">
                <span class="countdown-number">@_seconds.ToString("D2")</span>
                <span class="countdown-label">Seconds</span>
            </div>
        </div>
        @if (_launched)
        {
            <p class="text-green font-mono mt-3" style="font-size:.9rem;letter-spacing:.1em;">
                🚀 WE HAVE LIFTOFF — THE REBUILD HAS BEGUN
            </p>
        }
    </div>
</section>

<!-- MISSION PILLARS -->
<section id="mission" class="section-pad bg-dark-cb">
