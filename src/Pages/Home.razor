                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#febc2e;margin-right:6px;"></span>
                            <span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#28c840;"></span>
                        </div>
                        <span style="color:#4B5563;font-size:.75rem;">civicbounce-net-node-01.sh</span>
                        <span style="color:#374151;font-size:.7rem;">9600 BAUD</span>
                    </div>
                    <div class="terminal-body">
                        <div><span class="ts">[2026-05-25 12:00:00]</span> Initializing CivicBounce Node bootstrap...</div>
                        <div><span class="ts">[2026-05-25 12:00:01]</span> <span class="warn">WARNING:</span> Heavy political catastrophe detected. Local infrastructure failing.</div>
                        <div><span class="ts">[2026-05-25 12:00:02]</span> <span class="info">DECISION:</span> Initiating "Bounce Back" sequence.</div>
                        <div style="border-top:1px solid #1f2937;margin:.5rem 0;padding-top:.5rem;">
                            <span class="cmd">$</span> civicbounce --status<br/>
                            <span class="out">● NET_STATUS: &nbsp;&nbsp;&nbsp;&nbsp;BOOTSTRAPPING</span><br/>
                            <span class="out">● MASCOT_LOADED: &nbsp;FRIENDLY_PHOENIX (100%)</span><br/>
                            <span class="out">● LAUNCH_DATE: &nbsp;&nbsp;&nbsp;May 25, 2026 (Memorial Day)</span>
                        </div>
                        <div>
                            <span class="cmd">$</span> civicbounce --connect --channel=16<br/>
                            <span class="warn" style="animation:blink 1.5s infinite;">>>> Establishing radio handshake... CONNECTED. Welcome to the Rebuild.</span>
                            <span class="terminal-cursor"></span>
