                            <div class="signal-value">Memorial Day 2026</div>
                        </div>
                        <div class="col-4 signal-divider ps-3">
                            <div class="signal-label" style="color:var(--cb-blue);"><i class="fa-solid fa-circle-nodes me-1"></i> Grid Status</div>
