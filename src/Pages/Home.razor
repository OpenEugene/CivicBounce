</section>

<!-- SIGNUP FORM -->
<section id="join" class="signup-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6 text-center mb-5">
                <span class="section-tag tag-orange">Get On The Active List</span>
                <h2 class="text-white mb-3">Standby for Signal Activation</h2>
                <p class="text-muted-cb fs-5">
                    We launch Memorial Day 2026. Sign up to receive the frequency map, bootstrap forum access,
                    and localized event invites.
                </p>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">
                <div class="signup-card">
                    @if (!_submitted)
                    {
                        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                            <div class="mb-4">
                                <label class="cb-label">Your Name / Handle</label>
                                <input type="text"
                                       class="form-control cb-input @(_nameError ? "is-invalid" : "")"
                                       placeholder="e.g., Phoenix_Builder_9"
                                       @bind="_name" @bind:event="oninput" />
                                @if (_nameError) { <div class="field-error">Handle is required.</div> }
                            </div>
                            <div class="mb-4">
                                <label class="cb-label">Email (Secure Transmission)</label>
                                <input type="email"
                                       class="form-control cb-input @(_emailError ? "is-invalid" : "")"
                                       placeholder="e.g., builder@civicbounce.com"
                                       @bind="_email" @bind:event="oninput" />
                                @if (_emailError) { <div class="field-error">A valid email is required.</div> }
                            </div>
                            <div class="mb-4">
                                <label class="cb-label">Interest Level</label>
                                <select class="form-select cb-input @(_radioError ? "is-invalid" : "")"
                                        @bind="_radioStatus">
                                    <option value="">— How will you contribute? —</option>
                                    <option value="community_leader">Community Leader</option>
                                    <option value="builder">Builder</option>
                                    <option value="volunteer">Volunteer</option>
                                </select>
                                @if (_radioError) { <div class="field-error">Please select your interest level.</div> }
                            </div>
                            @if (!string.IsNullOrEmpty(_serverError))
                            {
                                <div class="alert mb-3" style="background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.3);color:#f87171;border-radius:10px;font-family:var(--font-mono);font-size:.8rem;padding:.75rem 1rem;">
                                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@_serverError
                                </div>
                            }
                            <button type="submit" class="cb-btn" disabled="@_submitting">
                                @if (_submitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Transmitting...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-tower-broadcast me-2"></i>
                                    <span>Transmit Registration</span>
                                }
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="success-icon mb-3"><i class="fa-solid fa-circle-check"></i></div>
                            <h4 class="text-white mb-2">Transmission Received!</h4>
                            <p class="text-muted-cb mb-4" style="font-size:.9rem;">
                                Your frequency handshake is complete. We've logged your handle.
                                Standby for a bootstrap packet in your inbox.
                            </p>
                            <button class="btn font-mono" style="color:var(--cb-orange);font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;background:none;border:none;" @onclick="ResetForm">
                                Send another transmission
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer class="cb-footer">
    <div class="container">
        <div class="d-flex justify-content-center gap-4 mb-3">
            <a href="https://github.com/OpenEugene/CivicBounce" target="_blank" rel="noopener">
                <i class="fa-brands fa-github" style="font-size:1.3rem;"></i>
            </a>
            <a href="#join"><i class="fa-solid fa-radio" style="font-size:1.3rem;"></i></a>
            <a href="mailto:hello@civicbounce.com"><i class="fa-solid fa-envelope" style="font-size:1.3rem;"></i></a>
        </div>
        <p class="mb-1">CivicBounce.com &copy; 2026</p>
        <p class="mb-0" style="color:#475569;">
            Built in response to the dumpster fire. We do not track you. We do not sell your data.
        </p>
    </div>
</footer>

@code {
    // Countdown
    private static readonly DateTime LaunchDate = new DateTime(2026, 5, 25, 12, 0, 0, DateTimeKind.Utc);
    private Timer? _timer;
    private int _days, _hours, _minutes, _seconds;
    private bool _launched;

    protected override void OnInitialized()
    {
        UpdateCountdown();
        _timer = new Timer(1000);
        _timer.Elapsed += async (_, _) => { UpdateCountdown(); await InvokeAsync(StateHasChanged); };
        _timer.Start();
    }

    private void UpdateCountdown()
    {
        var remaining = LaunchDate - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero) { _days = _hours = _minutes = _seconds = 0; _launched = true; }
        else { _days = (int)remaining.TotalDays; _hours = remaining.Hours; _minutes = remaining.Minutes; _seconds = remaining.Seconds; _launched = false; }
    }

    public void Dispose() => _timer?.Dispose();

    // Signup Form
    private string _name = "", _email = "", _radioStatus = "", _serverError = "";
    private bool _nameError, _emailError, _radioError, _submitting, _submitted;

    private const string GhPat = "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";
    private const string GhRepo = "OpenEugene/CivicBounce";

    private async Task HandleSubmit()
    {
        _nameError  = string.IsNullOrWhiteSpace(_name);
        _emailError = string.IsNullOrWhiteSpace(_email) || !_email.Contains('@');
        _radioError = string.IsNullOrWhiteSpace(_radioStatus);
        if (_nameError || _emailError || _radioError) return;

        _submitting = true;
        _serverError = "";
        try
        {
            var interestLabel = _radioStatus switch
            {
                "community_leader" => "Community Leader",
                "builder"         => "Builder",
                "volunteer"       => "Volunteer",
                _                 => _radioStatus
            };
            var title = $"[Signup] {_name.Trim()}";
            var body  = $"## New CivicBounce Signup\n\n| Field | Value |\n|---|---|\n| **Handle** | {_name.Trim()} |\n| **Email** | {_email.Trim()} |\n| **Interest Level** | {interestLabel} |\n| **Submitted** | {DateTime.UtcNow:yyyy-MM-dd HH:mm} UTC |";
            var payload = new { title, body, labels = new[] { "signup", _radioStatus } };

            using var request = new HttpRequestMessage(HttpMethod.Post,
                $"https://api.github.com/repos/{GhRepo}/issues");
            request.Headers.Add("Authorization", $"Bearer {GhPat}");
            request.Headers.Add("Accept", "application/vnd.github+json");
            request.Headers.Add("User-Agent", "CivicBounce-Signup/1.0");
            request.Content = JsonContent.Create(payload);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) { _submitted = true; }
            else { _serverError = $"Transmission failed (HTTP {(int)response.StatusCode}). Try again."; }
        }
        catch { _serverError = "Could not reach the relay station. Check your connection and try again."; }
        finally { _submitting = false; }
    }

    private void ResetForm()
    {
        _name = _email = _radioStatus = _serverError = "";
        _nameError = _emailError = _radioError = _submitted = _submitting = false;
    }
}
