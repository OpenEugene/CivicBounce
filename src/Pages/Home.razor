</section>

<!-- TERMINAL -->
<section class="section-pad" style="background:var(--cb-slate);">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-5">
                <div class="section-tag tag-green mb-3">
                    <i class="fa-solid fa-screwdriver-wrench"></i> What We Are Building
                </div>
                <h2 class="text-white mb-3">Tools to Organize, Coordinate, and Communicate</h2>
                <p class="text-muted-cb mb-4" style="line-height:1.7;">
                    A lightweight, robust stack built for real work. No bloat, no surveillance —
                    just high-performance infrastructure for civic action.
                </p>
                <ul class="list-unstyled font-mono" style="font-size:.85rem;color:var(--cb-muted);">
                    <li class="mb-2"><i class="fa-solid fa-check text-green me-2"></i>Secure, decentralized forums for regional planning</li>
                    <li class="mb-2"><i class="fa-solid fa-check text-green me-2"></i>Zero-tracking, lightning-fast Event Scheduler</li>
                    <li class="mb-2"><i class="fa-solid fa-check text-green me-2"></i>HAM/CB Radio registry and regional frequency maps</li>
                    <li class="mb-2"><i class="fa-solid fa-check text-green me-2"></i>Offline-first resource catalogs and mutual aid guides</li>
                </ul>
            </div>
            <div class="col-lg-7">
                <div class="terminal-wrap">
                    <div class="terminal-bar">
                        <div>
